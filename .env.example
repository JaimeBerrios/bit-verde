ENVIRONMENT=development
DATABASE_URL=sqlite:///./bitverde.db
PUBLIC_URL=https://bitverde.jaimeberrios.com
STAFF_USERNAME=staff
# Obligatoria para habilitar staff; mínimo 16 caracteres en producción.
STAFF_PASSWORD=
# Docker Compose: usa valores distintos y contraseñas URL-safe (hexadecimal).
MYSQL_DATABASE=bitverde
MYSQL_USER=bitverde
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
ACME_EMAIL=tu-correo@example.com
